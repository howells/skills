#!/bin/sh
set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
account=${1:-}

case "$account" in
  howells)
    credential_ref='op://keys/linear/credential'
    ;;
  material-instruments)
    credential_ref='op://keys/linear material-instruments/credential'
    ;;
  *)
    echo 'usage: graphql <howells|material-instruments>' >&2
    exit 64
    ;;
esac

if [ -z "${OP_SERVICE_ACCOUNT_TOKEN:-}" ]; then
  credential_file='/Users/danielhowells/.codex/plugins/secrets/1password-service-account.env'
  if [ ! -r "$credential_file" ]; then
    echo "Linear credential bootstrap is missing: $credential_file" >&2
    exit 78
  fi
  set -a
  . "$credential_file"
  set +a
fi

linear_key=$(python3 "$script_dir/read-credential.py" "$credential_ref")
exec 3<&0

response_file=$(mktemp)
trap 'rm -f "$response_file"' EXIT HUP INT TERM
if printf 'Authorization: %s\n' "$linear_key" | \
  curl --fail-with-body --silent --show-error \
    --connect-timeout 10 \
    --max-time 30 \
    https://api.linear.app/graphql \
    -H @- \
    -H 'Content-Type: application/json' \
    --data-binary @/dev/fd/3 >"$response_file"; then
  python3 "$script_dir/check-response.py" <"$response_file"
else
  cat "$response_file"
  exit 1
fi
