#!/bin/sh
set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
if [ "$#" -ne 0 ]; then
  echo 'usage: graphql <request.json (requires injected LINEAR_API_KEY)' >&2
  exit 64
fi
linear_key=$(python3 "$script_dir/read-credential.py" LINEAR_API_KEY)
exec 3<&0

response_file=$(mktemp)
trap 'rm -f "$response_file"' EXIT HUP INT TERM
if printf 'Authorization: %s\n' "$linear_key" | \
  curl --fail-with-body --silent --show-error \
    --connect-timeout 10 \
    --max-time 30 \
    https://api.linear.app/graphql \
    -H @- \
    -H 'Content-Type: application/json' \
    --data-binary @/dev/fd/3 >"$response_file"; then
  python3 "$script_dir/check-response.py" <"$response_file"
else
  cat "$response_file"
  exit 1
fi
