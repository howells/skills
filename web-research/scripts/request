#!/bin/sh
set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
provider=${1:-}
operation=${2:-}
resource_id=${3:-}

if [ -z "${OP_SERVICE_ACCOUNT_TOKEN:-}" ]; then
  credential_file='/Users/danielhowells/.codex/plugins/secrets/1password-service-account.env'
  if [ ! -r "$credential_file" ]; then
    echo "Web research credential bootstrap is missing: $credential_file" >&2
    exit 78
  fi
  set -a
  . "$credential_file"
  set +a
fi

exec 3<&0

post_with_bearer() {
  request_url=$1
  credential_ref=$2
  credential=$(python3 "$script_dir/read-credential.py" "$credential_ref")

  printf 'Authorization: Bearer %s\n' "$credential" | \
    curl --fail-with-body --silent --show-error \
      --connect-timeout 10 \
      --max-time 90 \
      "$request_url" \
      -H @- \
      -H 'Content-Type: application/json' \
      --data-binary @/dev/fd/3
}

get_with_bearer() {
  request_url=$1
  credential_ref=$2
  credential=$(python3 "$script_dir/read-credential.py" "$credential_ref")

  printf 'Authorization: Bearer %s\n' "$credential" | \
    curl --fail-with-body --silent --show-error \
      --connect-timeout 10 \
      --max-time 90 \
      "$request_url" \
      -H @-
}

case "$provider:$operation" in
  exa:search|exa:answer)
    post_with_bearer "https://api.exa.ai/$operation" 'op://keys/Exa/credential'
    ;;
  exa:contents)
    post_with_bearer 'https://api.exa.ai/contents' 'op://keys/Exa/credential'
    ;;
  tavily:search|tavily:extract|tavily:map|tavily:crawl|tavily:research)
    post_with_bearer "https://api.tavily.com/$operation" 'op://keys/Tavily/credential'
    ;;
  tavily:research-status)
    case "$resource_id" in
      ''|*[!A-Za-z0-9_-]*)
        echo 'usage: request tavily research-status <request-id>' >&2
        exit 64
        ;;
    esac
    get_with_bearer "https://api.tavily.com/research/$resource_id" 'op://keys/Tavily/credential'
    ;;
  *)
    echo 'usage: <request.json request exa <search|contents|answer> | <request.json request tavily <search|extract|map|crawl|research>; request tavily research-status <request-id>' >&2
    exit 64
    ;;
esac
